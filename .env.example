# --- Required -------------------------------------------------------------
# PostgreSQL connection string (e.g. Neon, Supabase, Railway, or local Postgres)
DATABASE_URL="postgresql://elevated:elevated@localhost:5432/elevated"
# Long random string used to sign login sessions: `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL of the site (used for Stripe redirects)
APP_URL="http://localhost:3000"

# --- AI (Claude) ----------------------------------------------------------
# From https://console.anthropic.com. Without it the app runs in demo mode
# with template-generated content instead of AI output.
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=""

# --- Payments (Stripe) ----------------------------------------------------
# Without these, every account stays on the free trial tier.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_ELITE=""

# --- Automation -----------------------------------------------------------
# Shared secret for the weekly autopilot job (Vercel Cron sends it as a Bearer token)
CRON_SECRET="change-me"

# --- Company --------------------------------------------------------------
# Public contact address shown in the footer, privacy policy, terms and llms.txt
CONTACT_EMAIL="support@elevatedlevel.app"

# Jarvis (/jarvis): read-only operations page. Optional passphrase; leave empty and Jarvis opens for anyone with the link.
JARVIS_ACCESS_CODE=
# Restricted Stripe key with Read on Balance, Charges, Subscriptions, Invoices (falls back to STRIPE_SECRET_KEY).
JARVIS_STRIPE_KEY=
# Fine-grained GitHub token: read-only Contents, Pull requests, Deployments on this repo.
GITHUB_TOKEN=

# --- Publishing & ad spend ------------------------------------------------
# Encrypts connected-account tokens at rest. `openssl rand -base64 32`. Required to connect channels.
# (CONNECTIONS_ENCRYPTION_KEY, the Winston app's name for it, also works.)
TOKEN_ENCRYPTION_KEY=
# AI images for posts and ads. Same keys as Joslin HQ / Winston. OpenAI is tried first, Gemini second.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GOOGLE_AI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Optional: one fee for everyone on wallet top-ups (percent). Leave empty to use the plan rates
# in src/lib/tiers.ts (12% Starter, 10% Growth, 8% Elite). 100% of the chosen amount goes to ads.
AD_MANAGEMENT_FEE_PERCENT=
# Each platform needs a developer app. Register this redirect URI with every app:
#   <APP_URL>/api/connect/<meta|google_ads|google_business|linkedin|tiktok|x>/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Wallet (managed) Meta ads: Elevated's Business Manager system-user token and ad account (act_...)
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_AD_COUNTRIES=US
# Google (Business Profile + Ads share one OAuth client). The Winston app's Google OAuth client can be
# reused: add this app's two Google redirect URIs to it in console.cloud.google.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v21
# Wallet (managed) Google ads: Elevated's manager (MCC) id, the account ads run in, and a refresh token for it
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_MANAGED_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
# Comma-separated geo target constants (2840 = United States)
GOOGLE_ADS_GEO_TARGETS=2840
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Add "w_organization_social r_organization_admin" once LinkedIn approves Community Management API
LINKEDIN_SCOPES=openid profile w_member_social
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Owners Hub (/hub): emails allowed in, comma separated. Defaults to the owner's email.
OWNER_EMAILS=justin.joslin@joslinholdings.biz
