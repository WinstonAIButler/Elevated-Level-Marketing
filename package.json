    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "next": "15.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^18.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.56.1",
    "prisma": "6.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
