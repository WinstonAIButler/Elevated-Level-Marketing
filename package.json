{
  "name": "elevated-digital-marketing",
  "version": "0.1.0",
  "private": true,
  "description": "Elevated Digital Marketing: automated assessments, marketing plans and AI-generated campaigns for client businesses.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
